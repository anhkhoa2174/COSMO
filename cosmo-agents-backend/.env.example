# Application Configuration
APP_NAME=cosmo-agents
ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
DEBUG=true

# Database Configuration
SQLALCHEMY_POSTGRES_URI=postgresql+asyncpg://postgres:postgres@localhost:5434/cosmo_agents
DB_MAX_OPEN_CONN=25
DB_MAX_IDLE_CONN=5

# Redis Configuration
REDIS_URL=redis://localhost:6381/0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=info
LOGGING_CONFIG_PATH=log.server.yaml

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24
ENABLE_AUTH=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MINUTES=1

# Coze Integration (optional)
# Base URL for Coze API
COZE_BASE_URL=
# OAuth client credentials for Coze token exchange
COZE_CLIENT_ID=
COZE_CLIENT_SECRET=

# OAuth2 - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/gmail/auth/callback

# Email
RESEND_API_KEY=your-resend-api-key

# AI/OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4

# Coze Integration
# COZE_APP_ID: Your Coze OAuth App ID (from Coze console)
COZE_APP_ID=your-coze-app-id
# COZE_PUBLIC_KEY_ID: Public key fingerprint (kid) configured in the Coze OAuth app
COZE_PUBLIC_KEY_ID=your-coze-public-key-id
# COZE_PRIVATE_KEY_PATH: Absolute path to your RSA private key in PEM format (PKCS1 or PKCS8). Restrict permissions (0600).
COZE_PRIVATE_KEY_PATH=/path/to/coze-private-key.pem
# COZE_BASE_URL: Override only for non-production Coze endpoints; default is https://api.coze.com
COZE_BASE_URL=https://api.coze.com

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn

# AWS S3
COSMO_BUCKET=your-s3-bucket-name
COSMO_BUCKET_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_ENDPOINT_URL=

# Loki Configuration (for direct log shipping)
LOKI_URL=http://localhost:3100
LOKI_USERNAME=
LOKI_PASSWORD=
LOKI_TENANT_ID=
