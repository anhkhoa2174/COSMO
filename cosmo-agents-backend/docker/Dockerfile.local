# Build the server and worker without reaching for ECR.
#
# docker/Dockerfile begins with a private base image whose only purpose is to
# supply two files:
#
#   COPY --from=certificates backend/cosmo-agents-golang/${TAG}/coze_oauth_private_key.pem ...
#   COPY --from=certificates backend/cosmo-agents-golang/${TAG}/.env ...
#
# That is how the deployment injects its secrets, and it means a developer
# cannot build the image at all without credentials for someone else's AWS
# account. Both files already sit in the working tree, so here they come from
# the build context and the private stage disappears.
FROM golang:1.25.7-alpine AS builder

WORKDIR /app
RUN apk add --no-cache git

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN go build -o bin/server ./cmd/server && \
    go build -o bin/worker ./cmd/worker

FROM alpine:latest
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata

COPY --from=builder /app/bin/server .
COPY --from=builder /app/bin/worker .
COPY --from=builder /app/docs ./docs
COPY --from=builder /app/migrations ./migrations
COPY --from=builder /app/internal/templates ./internal/templates

EXPOSE 8080
