{
  "manifest_version": 3,
  "name": "Cosmo LinkedIn Scraper",
  "version": "0.5.0",
  "description": "Scrape LinkedIn profile data and connections to Cosmo backend. Auto-login with Cosmo web app.",
  "permissions": ["activeTab", "storage", "scripting", "cookies"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost:3000/*",
    "http://localhost:8081/*",
    "http://127.0.0.1:8081/*",
    "https://*.cosmo.rockship.co/*",
    "https://cosmo.rockship.co/*",
    "https://*.rockship.xyz/*",
    "https://cosmoagents.rockship.xyz/*",
    "https://apicosmoagents.rockship.xyz/*"
  ],
  "action": {
    "default_title": "Send LinkedIn data to Cosmo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["https://www.linkedin.com/mynetwork/invite-connect/connections/*"],
      "js": ["content-connections.js"]
    }
  ]
}
