        </mxCell>
        <mxCell id="a1" value="Receive push notification&lt;br&gt;(prospect replied)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="105" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Backend: intake -->
        <mxCell id="a2" value="Fetch full email content&lt;br&gt;via Gmail API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="105" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Match email to&lt;br&gt;contact and campaign" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="180" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="Store email in&lt;br&gt;conversations table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="255" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- LLM: classification -->
        <mxCell id="a5" value="Classify reply intent&lt;br&gt;(9 categories)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="255" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Backend: every reply moves the contact out of NO_REPLY -->
        <mxCell id="a_state" value="Record intent;&lt;br&gt;update outreach_stage&lt;br&gt;(NO_REPLY → REPLIED)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="325" width="200" height="60" as="geometry" />
