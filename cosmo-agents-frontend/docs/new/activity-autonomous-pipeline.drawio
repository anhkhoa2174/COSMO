<mxfile host="app.diagrams.net">
  <diagram id="act-pipeline-v2" name="Automatic Pipeline Activity">
    <mxGraphModel dx="1400" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1110" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Swimlanes -->
        <mxCell id="lane_gmail" value="Gmail (Pub/Sub)" style="shape=swimlane;startSize=25;horizontal=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=11;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="180" height="1070" as="geometry" />
        </mxCell>
        <mxCell id="lane_sys" value="COSMO Backend (Worker)" style="shape=swimlane;startSize=25;horizontal=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=11;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="520" height="1070" as="geometry" />
        </mxCell>
        <mxCell id="lane_llm" value="LLM Service" style="shape=swimlane;startSize=25;horizontal=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=11;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="720" y="20" width="200" height="1070" as="geometry" />
