        <mxCell id="lane_p" value="Prospect" style="shape=swimlane;startSize=25;horizontal=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=11;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="160" height="1040" as="geometry" />
        </mxCell>
        <mxCell id="lane_bd" value="BD" style="shape=swimlane;startSize=25;horizontal=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontStyle=1;fontSize=11;collapsible=0;" vertex="1" parent="1">
