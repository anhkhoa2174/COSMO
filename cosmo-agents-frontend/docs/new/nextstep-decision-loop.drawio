<mxfile host="app.diagrams.net"><diagram name="next-step loop"><mxGraphModel dx="900" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;Event&lt;/b&gt;&lt;br&gt;sent · reply · timer · meeting · bounce" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="90" y="20" width="200" height="62" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;1. Observe&lt;/b&gt;&lt;br&gt;&lt;i&gt;code&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="104" width="200" height="62" as="geometry"/></mxCell><mxCell id="n4" value="Build the situation: stage, sends so far, time since last contact,&lt;br&gt;reply intent and its details (return date, referred person, revisit&lt;br&gt;date, objection), meetings, lead score" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="324" y="104" width="430" height="62" as="geometry"/></mxCell><mxCell id="n5" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="135.0" as="sourcePoint"/><mxPoint x="324" y="135.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n6" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190.0" y="82" as="sourcePoint"/><mxPoint x="190.0" y="104" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n7" value="&lt;b&gt;2. Filter&lt;/b&gt;&lt;br&gt;&lt;i&gt;code&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="188" width="200" height="62" as="geometry"/></mxCell><mxCell id="n8" value="Apply eligibility rules: opt-out, bounce, wait window, meeting&lt;br&gt;booked, send cap, campaign owns the sending.&lt;br&gt;Output: the set of eligible actions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="324" y="188" width="430" height="62" as="geometry"/></mxCell><mxCell id="n9" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="219.0" as="sourcePoint"/><mxPoint x="324" y="219.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n10" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190.0" y="166" as="sourcePoint"/><mxPoint x="190.0" y="188" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n11" value="&lt;b&gt;3. Select&lt;/b&gt;&lt;br&gt;&lt;i&gt;LLM, bounded&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="272" width="200" height="62" as="geometry"/></mxCell><mxCell id="n12" value="One eligible action: take it. Several: the LLM picks from the&lt;br&gt;eligible set only. Invalid answer or timeout: default cadence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="324" y="272" width="430" height="62" as="geometry"/></mxCell><mxCell id="n13" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="303.0" as="sourcePoint"/><mxPoint x="324" y="303.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n14" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190.0" y="250" as="sourcePoint"/><mxPoint x="190.0" y="272" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n15" value="&lt;b&gt;4. Approve&lt;/b&gt;&lt;br&gt;&lt;i&gt;human&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="356" width="200" height="62" as="geometry"/></mxCell><mxCell id="n16" value="Internal actions run automatically. Outbound messages need&lt;br&gt;approval. Sensitive replies go to a person to decide" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="324" y="356" width="430" height="62" as="geometry"/></mxCell><mxCell id="n17" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="387.0" as="sourcePoint"/><mxPoint x="324" y="387.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n18" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190.0" y="334" as="sourcePoint"/><mxPoint x="190.0" y="356" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n19" value="&lt;b&gt;5. Act&lt;/b&gt;&lt;br&gt;&lt;i&gt;code&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="90" y="440" width="200" height="62" as="geometry"/></mxCell><mxCell id="n20" value="Write the draft for the chosen action, or send nothing at all.&lt;br&gt;Store the decision record" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f8f8;strokeColor=#b3b3b3;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="324" y="440" width="430" height="62" as="geometry"/></mxCell><mxCell id="n21" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="471.0" as="sourcePoint"/><mxPoint x="324" y="471.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n22" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190.0" y="418" as="sourcePoint"/><mxPoint x="190.0" y="440" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n23" value="" style="html=1;rounded=0;strokeWidth=1.5;fontSize=13;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="471.0" as="sourcePoint"/><mxPoint x="90" y="51.0" as="targetPoint"/><Array as="points"><mxPoint x="50" y="471.0"/><mxPoint x="50" y="51.0"/></Array></mxGeometry></mxCell><mxCell id="n24" value="the next event starts a new pass" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;horizontal=0;" vertex="1" parent="1"><mxGeometry x="6" y="208" width="40" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>