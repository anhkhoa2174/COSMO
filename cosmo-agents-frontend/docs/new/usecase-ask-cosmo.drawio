<mxfile host="app.diagrams.net">
  <diagram id="uc-ask-cosmo" name="Ask COSMO Assistant">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sys" value="Ask COSMO Assistant Module" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=5;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="200" y="30" width="800" height="740" as="geometry" />
        </mxCell>

        <mxCell id="actor_bd" value="BD&#xa;(Sales Rep)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#000000;strokeColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="40" height="60" as="geometry" />
        </mxCell>

        <mxCell id="actor_visitor" value="Visitor&#xa;(unauthenticated)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#000000;strokeColor=#000000;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="40" height="60" as="geometry" />
        </mxCell>

        <mxCell id="actor_llm" value="&lt;font style=&quot;font-size:10px&quot;&gt;&amp;laquo;system&amp;raquo;&lt;/font&gt;&#xa;LLM Service" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1060" y="380" width="110" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_inapp" value="Query In-App&#xa;Assistant" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
