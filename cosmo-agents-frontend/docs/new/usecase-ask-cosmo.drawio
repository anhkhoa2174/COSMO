          <mxGeometry x="280" y="600" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="uc_restore" value="Restore Recent&#xa;Conversation" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="180" height="60" as="geometry" />
