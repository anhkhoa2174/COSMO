        <mxCell id="uc_tools" value="Call Backend Tools&#xa;(contacts, campaigns,&#xa;knowledge)" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
