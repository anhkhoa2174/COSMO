        <mxCell id="ext3" value="&lt;font style=&quot;font-size:10px&quot;&gt;&amp;laquo;extend&amp;raquo;&lt;/font&gt;" style="endArrow=open;endSize=10;dashed=1;dashPattern=8 4;strokeColor=#000000;strokeWidth=1;html=1;" edge="1" source="uc_delete" target="uc_browse" parent="1">
