<mxfile host="app.diagrams.net">
  <diagram id="uc-pipeline-v2" name="Automatic Pipeline Use Case">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="740" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- System boundary -->
        <mxCell id="boundary" value="Automatic AI Pipeline (no human trigger)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="10" width="720" height="712" as="geometry" />
        </mxCell>

        <!-- Actors -->
        <mxCell id="prospect" value="Prospect" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=none;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="30" height="60" as="geometry" />
        </mxCell>
        <mxCell id="gmail" value="«system»&lt;br&gt;&lt;b&gt;Gmail (Pub/Sub)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="llm" value="«system»&lt;br&gt;&lt;b&gt;LLM Service&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="940" y="330" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Use cases: column A (x 220), B (x 440), C (x 660) -->
        <mxCell id="uc_recv" value="Receive Prospect&lt;br&gt;Reply" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="90" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_class" value="Classify Reply Intent&lt;br&gt;(9 categories)" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_supp" value="Suppress Contact&lt;br&gt;(Do Not Contact)" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="40" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_route" value="Assign to&lt;br&gt;Campaign Owner" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="152" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_state" value="Update Outreach Stage&lt;br&gt;(NO_REPLY → REPLIED)" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="210" y="302" width="180" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_draft" value="Generate AI&lt;br&gt;Draft Reply" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="272" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_rag" value="Retrieve Knowledge&lt;br&gt;(RAG)" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="227" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_hist" value="Build Conversation&lt;br&gt;History" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="317" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_save" value="Save Draft to&lt;br&gt;Conversation" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="410" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_sse" value="Push SSE&lt;br&gt;Notification" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="530" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_enrich" value="Auto-enrich&lt;br&gt;New Contact" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="160" height="56" as="geometry" />
        </mxCell>
        <mxCell id="uc_score" value="Calculate Segment&lt;br&gt;Scores" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="640" width="160" height="56" as="geometry" />
        </mxCell>

        <!-- Associations -->
        <mxCell id="as_prospect" value="replies to campaign" style="endArrow=none;html=1;strokeColor=#000000;fontSize=9;fontStyle=2;labelBackgroundColor=#ffffff;entryX=0;entryY=0.5;" edge="1" source="prospect" target="uc_recv" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="-18" y="-14" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="as_gmail" value="pushes new email" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeColor=#000000;fontSize=9;fontStyle=2;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" source="gmail" target="uc_recv" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="250" /></Array><mxPoint x="30" y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="as_llm_class" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeColor=#000000;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="llm" target="uc_class" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="360" /><mxPoint x="880" y="118" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="as_llm_draft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeColor=#000000;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="llm" target="uc_draft" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="360" /><mxPoint x="880" y="300" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="as_llm_enrich" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeColor=#000000;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="llm" target="uc_enrich" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="360" /><mxPoint x="880" y="668" /></Array></mxGeometry>
        </mxCell>

        <!-- Include / extend -->
        <mxCell id="in_recv_class" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="uc_recv" target="uc_class" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-9" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="in_class_state" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.75;entryY=0;" edge="1" source="uc_class" target="uc_state" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ex_supp" value="«extend»&lt;br&gt;[DO_NOT_CONTACT]" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=0.9;entryY=0.2;" edge="1" source="uc_supp" target="uc_class" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="-8" y="-16" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="ex_route" value="«extend»&lt;br&gt;[other intents]" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=0.9;entryY=0.8;" edge="1" source="uc_route" target="uc_class" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="-4" y="14" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="ex_draft" value="«extend»&lt;br&gt;[INTERESTED /&lt;br&gt;PRICING / INFO]" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;align=left;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" source="uc_draft" target="uc_class" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="6" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="in_draft_rag" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.85;exitY=0.15;entryX=0;entryY=0.5;" edge="1" source="uc_draft" target="uc_rag" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-9" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="in_draft_hist" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.85;exitY=0.85;entryX=0;entryY=0.5;" edge="1" source="uc_draft" target="uc_hist" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="9" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="in_draft_save" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="uc_draft" target="uc_save" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="28" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="in_save_sse" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="uc_save" target="uc_sse" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="28" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="in_enrich_score" value="«include»" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" source="uc_enrich" target="uc_score" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-9" as="offset" /></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
