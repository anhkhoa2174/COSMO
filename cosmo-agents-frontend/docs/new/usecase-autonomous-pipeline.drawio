        <mxCell id="actor_llm" value="&lt;font style=&quot;font-size:10px&quot;&gt;&amp;laquo;system&amp;raquo;&lt;/font&gt;&#xa;LLM Service&#xa;(OpenAI)" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
