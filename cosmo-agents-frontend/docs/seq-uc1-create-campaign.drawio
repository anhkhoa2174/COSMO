          <mxGeometry x="720" y="60" width="120" height="850" as="geometry" />
        </mxCell>

        <mxCell id="worker" value="Asynq Worker" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;" vertex="1" parent="1">
          <mxGeometry x="940" y="60" width="120" height="850" as="geometry" />
