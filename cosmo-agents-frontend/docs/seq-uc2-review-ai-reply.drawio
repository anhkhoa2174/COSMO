            <mxPoint x="140" y="250" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 5. Select conversation -->
        <mxCell id="m5" value="5. Select conversation with AI draft" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="300" as="sourcePoint" />
