        <!-- Loop: create contacts -->
        <mxCell id="loop" value="loop [for each contact]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=140;height=20;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="550" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. Create/update contact by email" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;" edge="1" parent="1">
