        <!-- Alt: CSV -->
        <mxCell id="alt" value="alt [CSV Import]" style="shape=umlFrame;whiteSpace=wrap;html=1;width=100;height=20;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
