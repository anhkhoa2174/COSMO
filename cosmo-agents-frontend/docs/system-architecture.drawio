        <mxCell id="presentation" value="Presentation Layer (Frontend)" style="swimlane;fontStyle=1;align=center;startSize=25;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="1020" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fe_nextjs" value="Next.js 14&#xa;React 18" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="presentation">
