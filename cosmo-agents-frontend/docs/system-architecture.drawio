          <mxGeometry x="370" y="35" width="70" height="50" as="geometry" />
        </mxCell>
        <mxCell id="fe_shadcn" value="shadcn/ui" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="presentation">
