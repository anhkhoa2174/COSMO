<mxfile host="app.diagrams.net">
  <diagram id="sys-arch" name="System Architecture">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="System Architecture of COSMO" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="900" y="10" width="400" height="30" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- ACTORS (top) -->
        <!-- ============================================ -->
        <mxCell id="user_actor" value="BD (Sales Rep)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="50" width="40" height="60" as="geometry" />
        </mxCell>

        <mxCell id="prospect_actor" value="Prospect" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1640" y="50" width="40" height="60" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- SYSTEM BOUNDARY -->
        <!-- ============================================ -->
        <mxCell id="sys_boundary" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0066CC;strokeWidth=2;dashed=1;dashPattern=8 4;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="1100" height="1100" as="geometry" />
        </mxCell>
        <mxCell id="sys_label" value="&lt;b&gt;COSMO System&lt;/b&gt;" style="text;html=1;fontSize=14;fontColor=#0066CC;align=left;" vertex="1" parent="1">
          <mxGeometry x="70" y="165" width="150" height="25" as="geometry" />
        </mxCell>

        <!-- ============================================ -->
        <!-- LAYER 1: PRESENTATION -->
