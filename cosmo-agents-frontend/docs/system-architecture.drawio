        </mxCell>
        <mxCell id="fe_sse" value="EventSource&#xa;(SSE Client)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="presentation">
          <mxGeometry x="560" y="35" width="100" height="50" as="geometry" />
        </mxCell>

        <!-- User -> Presentation (bidirectional) -->
        <mxCell id="arr_user_fe" value="HTTP Request" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1">
