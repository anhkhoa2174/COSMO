<mxfile host="app.diagrams.net">
  <diagram id="uc-campaign" name="Campaign and Outreach">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="sys" value="Campaign &amp; Outreach Module" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=5;spacingLeft=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="220" y="30" width="720" height="720" as="geometry" />
        </mxCell>

